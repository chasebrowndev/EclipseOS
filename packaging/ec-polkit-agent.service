# The Eclipse polkit authentication agent: relays polkitd's password requests to
# the compositor, which draws the prompt and talks to polkit's root helper
# itself (COMP-10 §3.14, ADR 0088). Holds no secret. Installed to
# /usr/lib/systemd/user/ec-polkit-agent.service.
#
# Must run /usr/bin/ec-polkit-agent: the compositor refuses any other binary at
# its door. If it is down, polkit requests that need a password fail, and the
# session is not otherwise affected.
[Unit]
Description=Eclipse polkit authentication agent
PartOf=graphical-session.target
After=abyss-session.target
Requisite=abyss-session.target

[Service]
Type=simple
ExecStart=/usr/bin/ec-polkit-agent
Restart=on-failure
RestartSec=5
Slice=session.slice

[Install]
WantedBy=abyss-session.target
