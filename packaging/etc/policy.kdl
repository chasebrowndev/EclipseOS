// SPDX-License-Identifier: AGPL-3.0-only
// Shipped policy defaults — /etc/eclipse/policy.kdl. Owned by the image.
//
// This is a security default, not a convenience default, and it gets the same
// line-by-line owner review as TCB code (F-07 §4). Policy is fail-closed, so
// everything not granted is denied, and that is the correct starting
// position. What this file carries tightens, with one exception: the
// input-method grant below, without which no IME works at all (ADR 0094).
//
// It ships at all — rather than being omitted — so that the path, the owner and
// the file mode are established before anything is at stake. An empty file with
// the right ownership is easier to audit than a file that appears the first time
// someone grants something.
//
// Keys that belong in abyss.kdl are refused here, and vice versa (ADR 0037).
// There are deliberately no /etc/eclipse/policy.d/ drop-ins.

// The network/bluetooth secret prompt is an ordinary client, not trusted UI
// (COMP-10 §3 lists authority surfaces; a wifi passphrase is not one). It is
// an authentication surface, so the whole surface is `secret` (S-05 §2): no
// capture, no direct scanout. The app cannot declare this itself until
// COMP-09 lands, so the image does it here. Anchored — matchers are unanchored
// regexes, and `eclipse-secret-prompt-foo` must not inherit the class.
windowrule "sensitivity secret" { app-id "^ec-secret-prompt$"; }

// The agent console shows every agent's conversation: no agent may see it,
// hit it or capture it (A-08 §10). App-id is client-chosen, so this hides
// rather than trusts; the guarantee is the console's protected surface.
windowrule "no-agent" { app-id "^eclipse-console$"; }

// Who may be the input method (zwp_input_method_manager_v2, ADR 0094). An IME
// sees the focused text field and commits into it, so it is named, not
// ambient. Entries are executable paths: a bare name means /usr/bin/<name>,
// so a copy of `fcitx5` in /tmp or ~/.local/bin is not admitted. These are
// the Arch input-method_v2 daemons a user would actually install: fcitx5
// (the common CJK framework), kime (Korean) and squeekboard (the on-screen
// keyboard). An entry for a binary that is not installed admits nothing.
// Your own policy.kdl's `allow` replaces this list rather than adding to it.
input-method { allow "fcitx5" "kime" "squeekboard"; }

// No virtual-pointer grant: nothing in the image injects pointer input, and
// COMP-06 §2 wants that global off unless a client is named. Add
// `virtual-pointer { allow "/usr/bin/<tool>"; }` in your own policy.kdl.

// The taskbar's Oracle-Eyes eye is on-screen only; captures see the static eclipse.
capture { hide-layer "ec-hyperion-bar:eclipse-eye"; }
