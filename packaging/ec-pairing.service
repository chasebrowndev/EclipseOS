# The Eclipse Bluetooth pairing agent: registers org.bluez.Agent1 and serves
# org.eclipse.Services.Pairing, so PINs and passkeys go through
# ec-secret-prompt (ADR 0053, ADR 0066). Installed to
# /usr/lib/systemd/user/ec-pairing.service.
#
# Started by abyss-session.target, after which WAYLAND_DISPLAY is set for the
# prompts it spawns. Its own unit, not the taskbar's, so pairing works with no
# taskbar installed. If the system bus is unreachable it exits non-zero and is
# retried; the session is not affected -- pairing falls back to BlueZ's rules.
[Unit]
Description=Eclipse Bluetooth pairing agent
PartOf=graphical-session.target
After=abyss-session.target
Requisite=abyss-session.target

[Service]
Type=simple
ExecStart=/usr/bin/ec-pairing
Restart=on-failure
RestartSec=5
Slice=session.slice

[Install]
WantedBy=abyss-session.target
