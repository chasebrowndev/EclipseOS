# SPDX-License-Identifier: AGPL-3.0-only
# Maintainer: chase <chase.brown.dev@gmail.com>
#
# EclipseOS split package. Implements D-01 §1.1: every package out of one
# source build, because a per-package PKGBUILD would run `cargo build
# --release --workspace` once per package over the same tree.
#
# Each swappable DE component is its own package (ADR 0052): the taskbar,
# toasts, notification center and launcher install independently, so a user
# can run our toasts under another bar, or another bar under abyss.

pkgbase=eclipseos
pkgname=(eclipseos-abyss eclipseos-hyperion eclipseos-toasts eclipseos-wallpaper eclipseos-center
         eclipseos-launcher eclipseos-desktop eclipseos-agents eclipseos-setup eclipseos-fog eclipseos-anim-pack eclipseos-meta)
pkgver=0.1.1
pkgrel=1
pkgdesc="EclipseOS — agent-first Wayland desktop"
arch=(x86_64)
# zstd-sys compiles bundled C with makepkg CFLAGS; -flto=auto leaves GCC LTO
# bytecode that rust-lld cannot resolve (undefined ZSTD_* in policyd).
options=(!lto)
url="https://github.com/chasebrowndev/EclipseOS"
license=(AGPL-3.0-only)
makedepends=(git rust cargo pkgconf)
depends=(wayland libxkbcommon libinput libdrm libdisplay-info mesa seatd)
source=("git+https://github.com/chasebrowndev/EclipseOS.git#tag=v$pkgver")
sha256sums=('SKIP')

_src="EclipseOS"
# Five cargo workspaces under one repo: abyss/, shell/, installer/, oracle-eyes/, fog/ (ADR on layout).
_fog="EclipseOS/fog"

build() {
  # One target dir for every workspace, so _bin finds binaries in one place.
  export CARGO_TARGET_DIR="$srcdir/target"
  for ws in abyss shell installer; do
    (cd "$srcdir/$_src/$ws" && cargo build --release --workspace --bins --locked)
  done
  cd "$srcdir/$_fog"
  cargo build --release --bins --locked -p ec-fog-daemon -p ec-fog-ui
}

check() {
  export CARGO_TARGET_DIR="$srcdir/target"
  for ws in abyss shell installer fog; do
    (cd "$srcdir/$_src/$ws" && cargo test --workspace --release --locked)
  done
}

_bin() { install -Dm0755 "$srcdir/target/release/$1" "$pkgdir/usr/bin/$1"; }
_unit() { install -Dm0644 "$srcdir/$_src/packaging/$1" "$pkgdir/usr/lib/systemd/user/$1"; }
_app() { install -Dm0644 "$srcdir/$_src/packaging/applications/$1" "$pkgdir/usr/share/applications/$1"; }
# Enable a user unit for every user, image-side. A user-preset only takes effect
# when someone runs `systemctl --user preset-all`, which nothing does for an
# account that already exists — the bar shipped "enabled" and never started.
_want() {
  install -d "$pkgdir/usr/lib/systemd/user/abyss-session.target.wants"
  ln -sf "../$1" "$pkgdir/usr/lib/systemd/user/abyss-session.target.wants/$1"
}

package_eclipseos-abyss() {
  pkgdesc="EclipseOS compositor (abyss) and its control client"
  # xorg-xwayland is a hard dependency, not optional: abyss spawns the X server
  # at startup for the COMP-07 X11 trust domain. Without it the session dies
  # before it lights an output.
  depends=(wayland libxkbcommon libinput libdrm libdisplay-info mesa xorg-xwayland)
  optdepends=('seatd: fallback seat management when logind is unavailable (D-01 §5.3)')
  provides=(abyss)
  install=eclipseos.install

  for b in ec-abyss ec-ctl; do _bin "$b"; done
  install -Dm0755 "$srcdir/$_src/packaging/abyss-session" "$pkgdir/usr/bin/abyss-session"
  install -Dm0644 "$srcdir/$_src/packaging/abyss.desktop" \
    "$pkgdir/usr/share/wayland-sessions/abyss.desktop"
  _unit abyss-session.target
}

package_eclipseos-hyperion() {
  pkgdesc="EclipseOS taskbar (hyperion)"
  # The only DE component that talks to abyss directly (control socket).
  # eclipseos-desktop carries ec-secret-prompt, spawned for wifi passphrases.
  depends=(eclipseos-abyss eclipseos-desktop wayland libxkbcommon mesa networkmanager bluez bluez-utils upower)
  optdepends=('curl: Now Playing album art from https URLs (ADR 0065)'
              'foot: click actions of the premade widgets (ADR 0067)')

  _bin ec-hyperion-bar
  _unit ec-hyperion-bar.service
  _want ec-hyperion-bar.service
  # An add-on (ADR 0066): the manifest turns on abyss's taskbar-widgets hook.
  install -Dm0644 "$srcdir/$_src/packaging/addons/hyperion.kdl" \
    "$pkgdir/usr/share/eclipse/addons/hyperion.kdl"
  # Premade command widgets, approved by shipping (ADR 0067).
  install -Dm0644 -t "$pkgdir/usr/share/eclipse/widgets" "$srcdir/$_src"/packaging/widgets/*.kdl
}

package_eclipseos-toasts() {
  pkgdesc="EclipseOS notification toasts"
  # No abyss dependency: any layer-shell compositor will do. The session-target
  # link is inert without abyss-session.target; elsewhere, start the unit or
  # binary yourself.
  depends=(wayland libxkbcommon mesa)

  _bin ec-toasts
  _unit ec-toasts.service
  _want ec-toasts.service
}

package_eclipseos-wallpaper() {
  pkgdesc="EclipseOS wallpaper daemon"
  depends=(wayland libxkbcommon mesa)

  _bin ec-wallpaper
  _unit ec-wallpaper.service
  _want ec-wallpaper.service
}

package_eclipseos-center() {
  pkgdesc="EclipseOS notification and status center"
  depends=(wayland libxkbcommon mesa networkmanager bluez upower)

  _bin ec-center
  _app ec-center.desktop
}

package_eclipseos-launcher() {
  pkgdesc="EclipseOS application launcher"
  depends=(wayland libxkbcommon mesa)

  _bin ec-launcher
}

package_eclipseos-desktop() {
  pkgdesc="EclipseOS desktop apps: settings, policy viewer, agent console, screensaver, welcome, pairing agent, secret prompt"
  # Fonts for ec-welcome (D-07 step 0). Lora has no official package; the
  # version label falls back to a serif.
  depends=(eclipseos-abyss wayland libxkbcommon mesa networkmanager bluez ttf-cormorant noto-fonts-cjk)

  # ec-console is here, not in eclipseos-agents, because Super+/ is a
  # shipped default bind and every one names an installed binary; without
  # agentd it shows the agents as unavailable (A-08 §12).
  for b in ec-settings ec-policy-viewer ec-console ec-screensaver ec-welcome; do _bin "$b"; done
  # The Bluetooth pairing agent and the prompt it and the taskbar spawn by name
  # from PATH for pairing PINs and wifi passphrases (ADR 0053). Here, not in the
  # taskbar's package, so pairing works with no taskbar (ADR 0066).
  _bin ec-pairing
  _bin ec-secret-prompt
  _unit ec-screensaver.service
  _want ec-screensaver.service
  _unit ec-pairing.service
  _want ec-pairing.service
  _app ec-settings.desktop
  _app ec-policy-viewer.desktop
  _app ec-console.desktop
}

# The agent stack is one add-on (ADR 0069): installed by the Agentic profile,
# never by the floor. Every agent-only process ships here; abyss's half stays
# dormant until this manifest turns the `agents` hook on.
package_eclipseos-agents() {
  pkgdesc="EclipseOS agent stack add-on: policy daemon, secrets broker, agent daemon, inference router and audit reader (ADR 0069, 0076)"
  depends=(eclipseos-abyss bubblewrap)
  replaces=(eclipseos-policyd)
  conflicts=(eclipseos-policyd)

  _bin ec-policyd
  _bin ec-audit
  _bin ec-brokerd
  # Owner CLI for brokerd (S-08 §2); brokerd classifies it as the Owner peer.
  _bin ec-secret
  # The console backend and agent host (A-08). Never built with the
  # `dev-unsandboxed` feature. It starts agents under bwrap.
  _bin ec-agentd
  # The inference router (I-02, ADR 0076): the only process that holds a
  # model credential, released by brokerd per request.
  _bin ec-inferenced
  _unit ec-policyd.service
  _want ec-policyd.service
  _unit ec-brokerd.service
  _want ec-brokerd.service
  _unit ec-agentd.service
  _want ec-agentd.service
  _unit ec-inferenced.service
  _want ec-inferenced.service
  install -Dm0644 "$srcdir/$_src/packaging/addons/eclipseos-agents.kdl" \
    "$pkgdir/usr/share/eclipse/addons/eclipseos-agents.kdl"
  # The reference agent package (console wave): manifest beside its binary,
  # the entrypoint being relative to the package directory (A-07 §7).
  _ref="$pkgdir/usr/share/eclipse/agents/ec-ref-agent/0.1.0"
  install -Dm0644 "$srcdir/$_src/packaging/agents/ec-ref-agent/manifest.kdl" "$_ref/manifest.kdl"
  install -Dm0755 "$srcdir/target/release/ec-ref-agent" "$_ref/bin/ec-ref-agent"
  # Claude as a conversational agent (ADR 0076), chat only for now.
  _claude="$pkgdir/usr/share/eclipse/agents/ec-claude-agent/0.1.0"
  install -Dm0644 "$srcdir/$_src/packaging/agents/ec-claude-agent/manifest.kdl" "$_claude/manifest.kdl"
  install -Dm0755 "$srcdir/target/release/ec-claude-agent" "$_claude/bin/ec-claude-agent"
  # The same agent on the Claude Code backend: its own package directory (the
  # manifest id names the install path), the same binary.
  _claudecode="$pkgdir/usr/share/eclipse/agents/ec-claude-code-agent/0.1.0"
  install -Dm0644 "$srcdir/$_src/packaging/agents/ec-claude-code-agent/manifest.kdl" "$_claudecode/manifest.kdl"
  install -Dm0755 "$srcdir/target/release/ec-claude-agent" "$_claudecode/bin/ec-claude-agent"
}

package_eclipseos-setup() {
  pkgdesc="EclipseOS graphical installer and its root helper (D-07)"
  # Not in eclipseos-meta: the installed system does not carry the installer
  # until reconfigure (D-07 §8) exists. The tools are what the helper runs.
  depends=(eclipseos-abyss wayland libxkbcommon mesa polkit
           arch-install-scripts gptfdisk dosfstools e2fsprogs util-linux)

  for b in ec-setup ec-setup-helper; do _bin "$b"; done
  install -Dm0644 "$srcdir/$_src/packaging/polkit/org.eclipse.install.apply.policy" \
    "$pkgdir/usr/share/polkit-1/actions/org.eclipse.install.apply.policy"
}

package_eclipseos-fog() {
  pkgdesc="Fog, the EclipseOS file explorer (ec-fogd daemon and ec-fog-ui)"
  depends=(wayland libxkbcommon mesa)

  for b in ec-fogd ec-fog-ui; do
    install -Dm0755 "$srcdir/target/release/$b" "$pkgdir/usr/bin/$b"
  done
  for u in ec-fogd.socket ec-fogd.service; do
    install -Dm0644 "$srcdir/$_fog/dist/$u" "$pkgdir/usr/lib/systemd/user/$u"
  done
  # Socket-activated at login for every user (FOG §Architecture, Lifecycle),
  # by a shipped wants/ link as _want does, not a preset. sockets.target, not
  # abyss-session.target: fogd needs no display, and ec-fog-ui may start first.
  install -d "$pkgdir/usr/lib/systemd/user/sockets.target.wants"
  ln -sf ../ec-fogd.socket "$pkgdir/usr/lib/systemd/user/sockets.target.wants/ec-fogd.socket"
  install -Dm0644 "$srcdir/$_fog/dist/os.eclipse.fog.desktop" \
    "$pkgdir/usr/share/applications/os.eclipse.fog.desktop"
  # Fog as the folder handler (FOG §Desktop interop). With Fog, not in meta,
  # so the default never names an app that is not installed.
  install -Dm0644 "$srcdir/$_src/packaging/etc/abyss-mimeapps.list" \
    "$pkgdir/etc/xdg/abyss-mimeapps.list"
}

package_eclipseos-anim-pack() {
  pkgdesc="EclipseOS animation pack: shader window transitions for abyss"
  # Data only (ADR 0073): style files and GLSL bodies abyss compiles itself.
  # Not in eclipseos-meta; installing it is what turns the hook on.
  arch=(any)
  depends=(eclipseos-abyss)

  install -Dm0644 "$srcdir/$_src/packaging/addons/anim-pack.kdl" \
    "$pkgdir/usr/share/eclipse/addons/anim-pack.kdl"
  install -Dm0644 -t "$pkgdir/usr/share/eclipse/transitions/anim-pack" \
    "$srcdir/$_src"/packaging/transitions/anim-pack/*.{kdl,frag}
  install -Dm0644 -t "$pkgdir/usr/share/eclipse/transitions/anim-pack/presets" \
    "$srcdir/$_src"/packaging/transitions/anim-pack/presets/*.kdl
}

package_eclipseos-meta() {
  pkgdesc="EclipseOS base system (D-01 §1)"
  arch=(any)  # config and dependencies only, no ELF
  depends=(eclipseos-abyss eclipseos-toasts eclipseos-wallpaper eclipseos-center
           eclipseos-launcher eclipseos-desktop eclipseos-fog
           greetd greetd-regreet cage
           networkmanager bluez bluez-utils upower pipewire pipewire-pulse wireplumber
           foot xdg-user-dirs brightnessctl playerctl)
  # Add-ons (ADR 0066): suggested, not required. The session starts without
  # them; Super+E/R/N reach the launcher and center through built-in binds.
  optdepends=('eclipseos-hyperion: the taskbar add-on (workspaces, window chips, widgets, tray)'
              'eclipseos-agents: the agent stack add-on (ADR 0069)')
  # /etc/eclipse is image-owned (D-01 §4.1): deliberately NOT in backup(), so
  # pacman overwrites rather than leaving .pacnew, and the later atomic scheme
  # is a no-op migration.
  install -Dm0644 "$srcdir/$_src/packaging/etc/abyss.kdl"  "$pkgdir/etc/eclipse/abyss.kdl"
  install -Dm0644 "$srcdir/$_src/packaging/etc/policy.kdl" "$pkgdir/etc/eclipse/policy.kdl"

  # Pacman drop-in for the EclipseOS repo (D-02). /etc/pacman.conf must have
  # `Include = /etc/pacman.d/eclipseos.conf`; the ISO's airootfs ships that.
  install -Dm0644 "$srcdir/$_src/packaging/pacman/eclipseos.conf" \
    "$pkgdir/etc/pacman.d/eclipseos.conf"

  # Greeter. These live under /etc/eclipse, not /etc/greetd: config.toml and
  # regreet.toml there are owned by the greetd and greetd-regreet packages and
  # pacman refuses to co-own a file. The drop-in below points greetd at this
  # copy, and config.toml passes regreet --config/--style for its siblings.
  # The wallpaper goes under /usr/share because the `greeter` user cannot read
  # any home directory.
  install -Dm0644 "$srcdir/$_src/packaging/greetd/config.toml"  "$pkgdir/etc/eclipse/greetd/config.toml"
  install -Dm0644 "$srcdir/$_src/packaging/greetd/regreet.toml" "$pkgdir/etc/eclipse/greetd/regreet.toml"
  install -Dm0644 "$srcdir/$_src/packaging/greetd/regreet.css"  "$pkgdir/etc/eclipse/greetd/regreet.css"
  install -Dm0644 "$srcdir/$_src/packaging/greetd/10-eclipseos.conf" \
    "$pkgdir/usr/lib/systemd/system/greetd.service.d/10-eclipseos.conf"
  install -Dm0644 "$srcdir/$_src/packaging/greetd/wallpaper.png" \
    "$pkgdir/usr/share/backgrounds/eclipseos/greeter.png"

  # Boot splash systemd-stub draws from the UKI. The mkinitcpio preset is
  # generated, not package-owned, so eclipseos-postinstall.sh points its
  # `--splash` here.
  install -Dm0644 "$srcdir/$_src/packaging/boot/splash.bmp" \
    "$pkgdir/usr/share/eclipseos/splash.bmp"
  install -Dm0644 "$srcdir/$_src/packaging/systemd/10-eclipseos.conf" \
    "$pkgdir/usr/lib/systemd/system.conf.d/10-eclipseos.conf"

  # The same mark over the console at shutdown and reboot. Enabled by the
  # shipped wants/ symlink, not a preset (see HW-02 in KNOWNBUGS history).
  install -Dm0644 "$srcdir/$_src/packaging/boot/splash.bgr0" "$pkgdir/usr/share/eclipseos/splash.bgr0"
  install -Dm0755 "$srcdir/$_src/packaging/boot/ec-shutdown-splash" \
    "$pkgdir/usr/lib/eclipseos/shutdown-splash"
  install -Dm0644 "$srcdir/$_src/packaging/systemd/ec-shutdown-splash.service" \
    "$pkgdir/usr/lib/systemd/system/ec-shutdown-splash.service"
  install -d "$pkgdir/usr/lib/systemd/system/multi-user.target.wants"
  ln -sf ../ec-shutdown-splash.service \
    "$pkgdir/usr/lib/systemd/system/multi-user.target.wants/ec-shutdown-splash.service"
}
