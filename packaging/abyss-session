#!/bin/sh
# SPDX-License-Identifier: AGPL-3.0-only
# Login-session wrapper for Abyss. Install to /usr/bin/abyss-session.
#
# This sets only the environment that is knowable before the compositor runs.
# The systemd/D-Bus handoff is NOT done here: WAYLAND_DISPLAY does not exist
# until the compositor has created its socket, so the import must happen inside
# abyss, behind --session (ADR 0032).
export XDG_CURRENT_DESKTOP=Abyss
export XDG_SESSION_TYPE=wayland
export XDG_SESSION_DESKTOP=abyss
# The shipped foot.ini lives here because the foot package owns /etc/xdg's copy.
export XDG_CONFIG_DIRS="/etc/eclipse/xdg:${XDG_CONFIG_DIRS:-/etc/xdg}"
# --backend drm is explicit rather than inferred: default_backend() picks DRM
# only because WAYLAND_DISPLAY and DISPLAY are unset, and a greeter that leaks
# either into the session would silently start a nested winit compositor.
# greetd hands the session the VT as stdout/stderr; anything printed there
# shows as text between the greeter and the first frame, and again on logout.
# abyss logs to journald itself, so stray output goes there too.
#
# Before the compositor reads its config: append built-in taskbar widgets that
# a pinned bar.widgets.order lacks (ADR 0065). `--only widget-order` touches
# nothing else, and each id is offered once. Best effort: a failure here is
# logged and never stops the session.
#
# `--previous` (the "Abyss (previous)" entry, ADR 0101) skips the migration:
# the kept build may not know the widget ids today's ec-ctl would add.
previous=
if [ "${1:-}" = --previous ]; then
    previous=--previous
    shift
fi
if [ -z "$previous" ] && command -v ec-ctl >/dev/null 2>&1; then
    ec-ctl config migrate --only widget-order 2>&1 | systemd-cat -t abyss-session || true
fi
# A crashed session ends here and greetd shows the login screen again, where
# "Abyss (previous)" is listed (ADR 0101). `--previous` starts the kept build;
# without a kept copy (dev installs, first update) it starts the current one.
bin=ec-abyss
prev="${ECLIPSE_ROOT:-}/usr/lib/eclipse/previous/ec-abyss"
if [ -n "$previous" ] && [ -x "$prev" ]; then
    bin=$prev
fi
exec systemd-cat -t abyss-session "$bin" --backend drm --session "$@"
