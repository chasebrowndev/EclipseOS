// SPDX-License-Identifier: AGPL-3.0-only
// Add-on manifest (ADR 0066): /usr/share/eclipse/addons/firefox-glass.kdl, owned
// by the eclipseos-firefox-glass package. Turns on abyss's client-strips hook:
// the extension reports each window's page-area height through ec-glass-host and
// abyss sets the translucent strip itself, no windowrule needed (ADR 0079).
id "firefox-glass"
name "Glass for Firefox"
hooks "client-strips"
