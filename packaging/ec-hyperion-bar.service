# Hyperion, the Eclipse taskbar. Install to ~/.config/systemd/user/ec-hyperion-bar.service.
#
# Started by abyss-session.target, which `ec-abyss --session` starts once its
# Wayland socket exists and WAYLAND_DISPLAY has been imported into the user
# manager — so this unit can rely on the variable being set.
[Unit]
Description=Eclipse taskbar (hyperion)
PartOf=graphical-session.target
After=abyss-session.target
Requisite=abyss-session.target

[Service]
Type=simple
ExecStart=/usr/bin/ec-hyperion-bar
Restart=on-failure
RestartSec=2
Slice=session.slice

[Install]
WantedBy=abyss-session.target
