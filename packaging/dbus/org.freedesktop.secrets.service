# Shipped to /usr/share/eclipseos/dbus/; eclipseos-keyring.hook copies it to
# /usr/local/share/dbus-1/services/ while gnome-keyring is installed.
#
# gnome-keyring ships a service file for this name that execs a second
# daemon, racing gnome-keyring-daemon.service (socket-activated). The session
# bus searches /usr/local/share before /usr/share, so this copy wins and hands
# activation to the unit: one daemon. `Exec` is required by the format and is
# not used when `SystemdService` is present.
[D-BUS Service]
Name=org.freedesktop.secrets
Exec=/usr/bin/false
SystemdService=gnome-keyring-daemon.service
