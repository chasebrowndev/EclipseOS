[Unit]
Description=EclipseOS live installer (D-07 §2.1)
PartOf=graphical-session.target
ConditionPathExists=/run/archiso

[Service]
# The graphical installer; it embeds the welcome step (D-07 step 0).
ExecStart=/usr/bin/ec-setup --install
Restart=on-failure
RestartSec=1

[Install]
WantedBy=abyss-session.target
