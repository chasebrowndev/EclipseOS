# remove from airootfs!
[Trigger]
Operation = Install
Operation = Upgrade
Type = Package
Target = pacman-mirrorlist

[Action]
Description = Uncommenting HTTPS mirrors, preferred mirrors first...
When = PostTransaction
Depends = pacman-mirrorlist
Depends = sed
# eclipseos-mirrors (D-03 §4.3) goes on top: the installer's retry rotates the
# first Server to the end, so the list it walks starts with known-good mirrors.
# It is staged under its own name because pacman-mirrorlist owns `mirrorlist`.
Exec = /usr/bin/sh -c "sed -E -i 's/#(Server = https:)/\\1/g' /etc/pacman.d/mirrorlist && cat /etc/pacman.d/eclipseos-mirrors /etc/pacman.d/mirrorlist > /etc/pacman.d/mirrorlist.new && mv /etc/pacman.d/mirrorlist.new /etc/pacman.d/mirrorlist"
