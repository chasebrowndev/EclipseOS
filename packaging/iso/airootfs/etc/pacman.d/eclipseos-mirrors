# EclipseOS live medium mirror list (D-03 §4.3).
#
# Order matters. pacman tries these top to bottom, and install-eclipseos.sh and
# the graphical installer rotate the list between failed pacstrap attempts so a
# stalled mirror is not tried first twice. A few HTTPS mirrors on different
# networks, so one that is filtered or slow from a given site is not fatal.
# This file replaces the stock all-commented pacman-mirrorlist on the medium; the
# installed system inherits it from pacstrap and can run reflector on its own.
Server = https://geo.mirror.pkgbuild.com/$repo/os/$arch
Server = https://mirrors.kernel.org/archlinux/$repo/os/$arch
Server = https://mirror.rackspace.com/archlinux/$repo/os/$arch
Server = https://mirror.leaseweb.net/archlinux/$repo/os/$arch
Server = https://mirrors.mit.edu/archlinux/$repo/os/$arch
Server = https://ftp.halifax.rwth-aachen.de/archlinux/$repo/os/$arch
