# The Eclipse xdg-desktop-portal backend: owns
# org.freedesktop.impl.portal.desktop.abyss, publishes the light/dark scheme
# and accent from the compositor (ADR 0084) and opens Fog as the file chooser
# (ADR 0100; without ec-fog-ui on PATH a request answers "other" at once). Installed to
# /usr/lib/systemd/user/ec-portal.service.
#
# Bus-activated (see org.freedesktop.impl.portal.desktop.abyss.service) the
# first time xdg-desktop-portal needs a setting, so it has no [Install]. If the
# compositor is unreachable it serves dark and keeps retrying.
[Unit]
Description=Eclipse portal backend (settings, file chooser)

[Service]
Type=dbus
BusName=org.freedesktop.impl.portal.desktop.abyss
ExecStart=/usr/bin/ec-portal
Restart=on-failure
RestartSec=5
Slice=session.slice
