# The Eclipse desktop portal. Installed to /usr/lib/systemd/user/.
#
# Untrusted session process (ADR 0084): no ambient capture or input authority.
# Hardening that would be inherited by launched applications (NoNewPrivileges,
# UMask) is deliberately absent: the direct-spawn fallback in OpenURI runs
# handlers as children of this unit.
[Unit]
Description=Eclipse desktop portal
PartOf=graphical-session.target
After=abyss-session.target
BindsTo=abyss-session.target

[Service]
Type=dbus
BusName=org.freedesktop.portal.Desktop
ExecStart=/usr/bin/ecl-desktop-portal
Restart=on-failure
RestartSec=1
# Handlers started without systemd-run must survive a portal restart.
KillMode=process
Slice=session.slice

[Install]
WantedBy=abyss-session.target
