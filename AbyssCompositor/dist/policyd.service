# The Eclipse policy daemon. Installed to /usr/lib/systemd/user/policyd.service.
#
# A *user* service, not a system one: its journal and its issuer key are
# per-user state under ~/.local/state/eclipse/policyd (D-01 §3.4, §4.3).
#
# Ordering is Before= and not BindsTo=: abyss must still paint with policyd
# down, and every policy check is fail-closed on its own, so a missing daemon
# denies rather than crashes. There is deliberately no StartLimitBurst escape —
# a TCB daemon that crash-loops must make the session unusable, not quietly
# degraded. Restart=on-failure and not always for the same reason: a clean
# exit of a TCB daemon is a decision it made.
#
# Not socket-activated: COMP-11 `check()` is a hot path that may not allocate,
# and a first-call connect is not a cost it can pay.
[Unit]
Description=Eclipse policy daemon
PartOf=graphical-session.target
Before=abyss-session.target

# Type=simple, not notify: policyd does not sd_notify READY=1, and nothing
# needs it to. abyss redials policyd.sock every second and checks that the
# peer's cgroup is this unit (F-05), so ordering only shortens the wait.
# Renaming the unit breaks that check.
[Service]
Type=simple
ExecStart=/usr/bin/policyd
Restart=on-failure
RestartSec=1

[Install]
WantedBy=abyss-session.target
