# SPDX-License-Identifier: AGPL-3.0-only
# Maintainer: chase <chase.brown.dev@gmail.com>
#
# EclipseOS split package. Implements D-01 §1.1: every package out of one
# source build, because a per-package PKGBUILD would run `cargo build
# --release --workspace` once per package over the same tree.
#
# Each swappable DE component is its own package (ADR 0052): the taskbar,
# toasts, notification center and launcher install independently, so a user
# can run our toasts under another bar, or another bar under abyss.

pkgbase=eclipseos
pkgname=(eclipseos-abyss eclipseos-hyperion eclipseos-toasts eclipseos-center
         eclipseos-launcher eclipseos-desktop eclipseos-policyd eclipseos-meta)
pkgver=0.1.1
pkgrel=1
pkgdesc="EclipseOS — agent-first Wayland desktop"
arch=(x86_64)
# zstd-sys compiles bundled C with makepkg CFLAGS; -flto=auto leaves GCC LTO
# bytecode that rust-lld cannot resolve (undefined ZSTD_* in policyd).
options=(!lto)
url="https://github.com/chasebrowndev/EclipseOS"
license=(AGPL-3.0-only)
makedepends=(git rust cargo pkgconf)
depends=(wayland libxkbcommon libinput libdrm libdisplay-info mesa seatd)
source=("git+https://github.com/chasebrowndev/EclipseOS.git#tag=v$pkgver")
sha256sums=('SKIP')

_src="EclipseOS/AbyssCompositor"

build() {
  cd "$_src"
  cargo build --release --workspace --bins --locked
}

check() {
  cd "$_src"
  cargo test --workspace --release --locked
}

_bin() { install -Dm0755 "$srcdir/$_src/target/release/$1" "$pkgdir/usr/bin/$1"; }
_unit() { install -Dm0644 "$srcdir/$_src/dist/$1" "$pkgdir/usr/lib/systemd/user/$1"; }
_app() { install -Dm0644 "$srcdir/$_src/dist/applications/$1" "$pkgdir/usr/share/applications/$1"; }
# Enable a user unit for every user, image-side. A user-preset only takes effect
# when someone runs `systemctl --user preset-all`, which nothing does for an
# account that already exists — the bar shipped "enabled" and never started.
_want() {
  install -d "$pkgdir/usr/lib/systemd/user/abyss-session.target.wants"
  ln -sf "../$1" "$pkgdir/usr/lib/systemd/user/abyss-session.target.wants/$1"
}

package_eclipseos-abyss() {
  pkgdesc="EclipseOS compositor (abyss) and its control client"
  # xorg-xwayland is a hard dependency, not optional: abyss spawns the X server
  # at startup for the COMP-07 X11 trust domain. Without it the session dies
  # before it lights an output.
  depends=(wayland libxkbcommon libinput libdrm libdisplay-info mesa xorg-xwayland)
  optdepends=('seatd: fallback seat management when logind is unavailable (D-01 §5.3)')
  provides=(abyss)

  for b in abyss eclipse-ctl; do _bin "$b"; done
  install -Dm0755 "$srcdir/$_src/dist/abyss-session" "$pkgdir/usr/bin/abyss-session"
  install -Dm0644 "$srcdir/$_src/dist/abyss.desktop" \
    "$pkgdir/usr/share/wayland-sessions/abyss.desktop"
  _unit abyss-session.target
}

package_eclipseos-hyperion() {
  pkgdesc="EclipseOS taskbar (hyperion)"
  # The only DE component that talks to abyss directly (control socket).
  depends=(eclipseos-abyss wayland libxkbcommon mesa networkmanager bluez bluez-utils upower)

  _bin hyperion
  # Spawned by name from PATH for wifi passphrases and pairing PINs (ADR 0053).
  _bin eclipse-secret-prompt
  _unit hyperion.service
  _want hyperion.service
}

package_eclipseos-toasts() {
  pkgdesc="EclipseOS notification toasts"
  # No abyss dependency: any layer-shell compositor will do. The session-target
  # link is inert without abyss-session.target; elsewhere, start the unit or
  # binary yourself.
  depends=(wayland libxkbcommon mesa)

  _bin eclipse-toasts
  _unit eclipse-toasts.service
  _want eclipse-toasts.service
}

package_eclipseos-center() {
  pkgdesc="EclipseOS notification and status center"
  depends=(wayland libxkbcommon mesa networkmanager bluez upower)

  _bin eclipse-center
  _app eclipse-center.desktop
}

package_eclipseos-launcher() {
  pkgdesc="EclipseOS application launcher"
  depends=(wayland libxkbcommon mesa)

  _bin eclipse-launcher
}

package_eclipseos-desktop() {
  pkgdesc="EclipseOS desktop apps: settings, policy viewer, screensaver, welcome"
  # Fonts for eclipse-welcome (D-07 step 0). Lora has no official package; the
  # version label falls back to a serif.
  depends=(eclipseos-abyss wayland libxkbcommon mesa ttf-cormorant noto-fonts-cjk)

  for b in eclipse-settings eclipse-policy-viewer eclipse-screensaver eclipse-welcome; do _bin "$b"; done
  _unit eclipse-screensaver.service
  _want eclipse-screensaver.service
  _app eclipse-settings.desktop
  _app eclipse-policy-viewer.desktop
}

package_eclipseos-policyd() {
  pkgdesc="EclipseOS policy daemon"
  depends=(eclipseos-abyss)

  _bin policyd
  _unit policyd.service
  _want policyd.service
}

package_eclipseos-meta() {
  pkgdesc="EclipseOS base system (D-01 §1)"
  arch=(any)  # config and dependencies only, no ELF
  depends=(eclipseos-abyss eclipseos-hyperion eclipseos-toasts eclipseos-center
           eclipseos-launcher eclipseos-desktop eclipseos-policyd
           greetd greetd-regreet cage
           networkmanager bluez bluez-utils upower pipewire pipewire-pulse wireplumber
           foot xdg-user-dirs brightnessctl playerctl)
  # /etc/eclipse is image-owned (D-01 §4.1): deliberately NOT in backup(), so
  # pacman overwrites rather than leaving .pacnew, and the later atomic scheme
  # is a no-op migration.
  install -Dm0644 "$srcdir/$_src/dist/etc/abyss.kdl"  "$pkgdir/etc/eclipse/abyss.kdl"
  install -Dm0644 "$srcdir/$_src/dist/etc/policy.kdl" "$pkgdir/etc/eclipse/policy.kdl"

  # Pacman drop-in for the EclipseOS repo (D-02). /etc/pacman.conf must have
  # `Include = /etc/pacman.d/eclipseos.conf`; the ISO's airootfs ships that.
  install -Dm0644 "$srcdir/$_src/dist/pacman/eclipseos.conf" \
    "$pkgdir/etc/pacman.d/eclipseos.conf"

  # Greeter. These live under /etc/eclipse, not /etc/greetd: config.toml and
  # regreet.toml there are owned by the greetd and greetd-regreet packages and
  # pacman refuses to co-own a file. The drop-in below points greetd at this
  # copy, and config.toml passes regreet --config/--style for its siblings.
  # The wallpaper goes under /usr/share because the `greeter` user cannot read
  # any home directory.
  install -Dm0644 "$srcdir/$_src/dist/greetd/config.toml"  "$pkgdir/etc/eclipse/greetd/config.toml"
  install -Dm0644 "$srcdir/$_src/dist/greetd/regreet.toml" "$pkgdir/etc/eclipse/greetd/regreet.toml"
  install -Dm0644 "$srcdir/$_src/dist/greetd/regreet.css"  "$pkgdir/etc/eclipse/greetd/regreet.css"
  install -Dm0644 "$srcdir/$_src/dist/greetd/10-eclipseos.conf" \
    "$pkgdir/usr/lib/systemd/system/greetd.service.d/10-eclipseos.conf"
  install -Dm0644 "$srcdir/$_src/dist/greetd/wallpaper.png" \
    "$pkgdir/usr/share/backgrounds/eclipseos/greeter.png"

  # Boot splash systemd-stub draws from the UKI. The mkinitcpio preset is
  # generated, not package-owned, so eclipseos-postinstall.sh points its
  # `--splash` here.
  install -Dm0644 "$srcdir/$_src/dist/boot/splash.bmp" \
    "$pkgdir/usr/share/eclipseos/splash.bmp"
  install -Dm0644 "$srcdir/$_src/dist/systemd/10-eclipseos.conf" \
    "$pkgdir/usr/lib/systemd/system.conf.d/10-eclipseos.conf"

  # The same mark over the console at shutdown and reboot. Enabled by the
  # shipped wants/ symlink, not a preset (see HW-02 in KNOWNBUGS history).
  install -Dm0644 "$srcdir/$_src/dist/boot/splash.bgr0" "$pkgdir/usr/share/eclipseos/splash.bgr0"
  install -Dm0755 "$srcdir/$_src/dist/boot/eclipse-shutdown-splash" \
    "$pkgdir/usr/lib/eclipseos/shutdown-splash"
  install -Dm0644 "$srcdir/$_src/dist/systemd/eclipse-shutdown-splash.service" \
    "$pkgdir/usr/lib/systemd/system/eclipse-shutdown-splash.service"
  install -d "$pkgdir/usr/lib/systemd/system/multi-user.target.wants"
  ln -sf ../eclipse-shutdown-splash.service \
    "$pkgdir/usr/lib/systemd/system/multi-user.target.wants/eclipse-shutdown-splash.service"
}
