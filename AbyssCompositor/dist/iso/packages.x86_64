# EclipseOS live/install medium package set (D-03 §2).
#
# Two jobs, deliberately not separated: this list is both what the live medium
# boots with and what `install-eclipseos.sh` pacstraps onto the target. Keeping
# one list means the thing you tried on the live ISO is the thing you installed.

## boot and kernel (D-01 §2)
linux
linux-firmware
linux-firmware-amdgpu
amd-ucode
mkinitcpio
mkinitcpio-archiso
mkinitcpio-nfs-utils
base
syslinux
edk2-shell
memtest86+-efi

## filesystem and disk tools the installer needs
e2fsprogs
dosfstools
exfatprogs
btrfs-progs
xfsprogs
gptfdisk
parted
cryptsetup
lvm2
mdadm
arch-install-scripts
archinstall

## base userland
sudo
which
less
nano
micro
man-db
man-pages
usbutils
pciutils
lsof
htop
rsync
wget
curl
git
openssh
zsh

## graphics stack (D-01 §1) — amdgpu is in-kernel, no DKMS
mesa
vulkan-radeon
libva-mesa-driver
libdrm
libdisplay-info
libxkbcommon
wayland
wayland-utils
seatd
libinput

## services the DE consumes over D-Bus (D-01 §1)
networkmanager
bluez
bluez-utils
upower
pipewire
pipewire-pulse
pipewire-alsa
wireplumber
alsa-utils
polkit

## keyring handling (D-03 §5)
# The installer imports the EclipseOS packaging key with pacman-key, which
# shells out to gpg -- that is gnupg, not a pacman dependency.
gnupg
archlinux-keyring

## networking on the medium and after it (D-03 §2)
# iwd is what the live medium's enabled iwd.service and 20-wlan.network expect;
# without it the Framework has no wifi at all and it has no ethernet port.
# wpa_supplicant is NetworkManager's default backend on the installed system.
# wireless-regdb keeps the radio inside its regulatory domain.
iwd
iw
wireless-regdb
wpa_supplicant
# Framework 13 AMD audio is SOF; without this there are no output devices.
sof-firmware
# The panel is 2256x1504. The default console font is unreadable on it, and
# this installer is a console program.
terminus-font

## greeter and session (D-01 §3)
greetd
greetd-regreet
cage
foot
xdg-user-dirs
xdg-utils
noto-fonts
noto-fonts-emoji
ttf-jetbrains-mono-nerd

## EclipseOS itself (D-01 §1) — pulls abyss, desktop and policyd
eclipseos-meta
