{
  "manifest_version": 3,
  "name": "Glass for Firefox",
  "version": "0.1.0",
  "description": "Makes Firefox match the EclipseOS desktop: warm dark, gold accent, liquid glass. The compositor supplies the translucency.",
  "browser_specific_settings": {
    "gecko": {
      "id": "glass@eclipseos",
      "strict_min_version": "142.0",
      "data_collection_permissions": { "required": ["none"] }
    }
  },
  "permissions": ["theme", "storage", "nativeMessaging"],
  "background": {
    "scripts": ["shared/glass.js", "background.js"]
  },
  "chrome_url_overrides": {
    "newtab": "newtab/newtab.html"
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  }
}
