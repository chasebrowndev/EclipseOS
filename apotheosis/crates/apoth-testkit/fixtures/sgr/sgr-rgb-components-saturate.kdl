fixture "sgr-rgb-components-saturate" {
  desc "component values above 255 saturate to 255"
  covers "T03-SGR-COLOR" "T03-SGR-SATURATE" "VTCORE-16"
  size rows=2 cols=20
  feed #"\e[38;2;300;256;999mA\e[38:2::300:0:0mB"#
  grid {
    row "AB"
  }
  cursor row=0 col=2
  cell row=0 col=0 ch="A" fg="#ffffff"
  cell row=0 col=1 ch="B" fg="#ff0000"
}
