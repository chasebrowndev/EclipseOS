fixture "sgr-semicolon-rgb-consumes-four" {
  desc "`;2;R;G;B` consumes exactly those parameters; the next one applies"
  covers "T03-SGR-COLOR" "T03-SGR-AMBIG" "VTCORE-16"
  size rows=2 cols=20
  feed #"\e[38;2;1;2;3;4mX"#
  grid {
    row "X"
  }
  cursor row=0 col=1
  cell row=0 col=0 ch="X" fg="#010203" ul="single"
}
