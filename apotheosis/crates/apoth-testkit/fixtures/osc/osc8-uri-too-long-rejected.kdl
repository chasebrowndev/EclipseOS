fixture "osc8-uri-too-long-rejected" {
  desc "a 2084-byte URI is rejected; the text still prints"
  covers "T03-OSC8" "VTCORE-29"
  review "T-02/T-18 give the limit but not the failure behaviour; assuming the link is ignored and printing continues"
  size rows=3 cols=20
  feed #"\e]8;;https://e.\aX"#
  grid {
    row "X"
  }
  cell row=0 col=0 ch="X" link=#null
}
