fixture "kitty-scrolls-with-text" {
  desc "placements are anchored to rows and scroll into history"
  covers "T03-GRAPHICS-KITTY"
  size rows=3 cols=6
  feed #"\e_Ga=T,f=24,s=2,v=1,i=7,C=1,q=1;/wAA/wAA\e\\"#
  feed #"\r\n\n\n"#
  images {
    row "kitty row=-1 col=0 cols=1 rows=1 z=0"
  }
}
