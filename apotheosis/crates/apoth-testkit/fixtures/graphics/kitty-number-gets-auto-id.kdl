fixture "kitty-number-gets-auto-id" {
  desc "I= transmits get an id from the upper half, echoed with the number"
  covers "T03-GRAPHICS-KITTY"
  size rows=4 cols=6
  feed #"\e_Ga=t,f=24,s=2,v=1,I=5;/wAA/wAA\e\\"#
  feed #"\e_Ga=p,I=5,C=1\e\\"#
  replies #"\e_Gi=2147483648,I=5;OK\e\\\e_Gi=2147483648,I=5;OK\e\\"#
  images {
    row "kitty row=0 col=0 cols=1 rows=1 z=0"
  }
}
