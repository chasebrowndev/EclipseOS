fixture "kitty-delete-lower-keeps-data" {
  desc "d=a keeps the data: the image can be placed again"
  covers "T03-GRAPHICS-KITTY"
  size rows=3 cols=6
  feed #"\e_Ga=T,f=24,s=2,v=1,i=7,C=1,q=1;/wAA/wAA\e\\"#
  feed #"\e_Ga=d,d=a\e\\"#
  feed #"\e_Ga=p,i=7,C=1\e\\"#
  images {
    row "kitty row=0 col=0 cols=1 rows=1 z=0"
  }
  replies #"\e_Gi=7;OK\e\\"#
}
