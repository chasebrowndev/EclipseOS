fixture "sixel-text-overwrites-slice" {
  desc "text printed over a slice removes it"
  covers "T03-GRAPHICS-SIXEL"
  size rows=4 cols=6
  feed #"\eP0;1;0q"1;1;8;18#1;2;100;0;0#1!8~-!8~-!8~\e\\"#
  feed #"\e[1;1HX"#
  images {
    row "sixel row=1 col=0 cols=1 rows=1 z=0"
  }
}
