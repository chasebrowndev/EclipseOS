fixture "kitty-text-over-keeps-image" {
  desc "printing over a kitty image leaves it"
  covers "T03-GRAPHICS-KITTY"
  size rows=3 cols=6
  feed #"\e_Ga=T,f=24,s=2,v=1,i=7,C=1,q=1;/wAA/wAA\e\\"#
  feed #"XYZ"#
  images {
    row "kitty row=0 col=0 cols=1 rows=1 z=0"
  }
}
