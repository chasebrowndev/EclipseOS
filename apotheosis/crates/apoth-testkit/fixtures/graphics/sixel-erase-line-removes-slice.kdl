fixture "sixel-erase-line-removes-slice" {
  desc "EL over a slice removes it"
  covers "T03-GRAPHICS-SIXEL"
  size rows=4 cols=6
  feed #"\eP0;1;0q"1;1;8;18#1;2;100;0;0#1!8~-!8~-!8~\e\\"#
  feed #"\e[2;1H\e[2K"#
  images {
    row "sixel row=0 col=0 cols=1 rows=1 z=0"
  }
}
