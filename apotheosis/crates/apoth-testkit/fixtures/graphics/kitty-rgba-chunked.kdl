fixture "kitty-rgba-chunked" {
  desc "m=1 chunks assemble into one image (4096-byte chunks)"
  covers "T03-GRAPHICS-KITTY"
  size rows=4 cols=6
  feed #"\e_Ga=T,f=32,s=16,v=16,i=3,m=1;\e\\"#
  feed #"\e_Gm=1;\e\\"#
  feed #"\e_Gm=0;/w==\e\\"#
  replies #"\e_Gi=3;OK\e\\"#
  images {
    row "kitty row=0 col=0 cols=2 rows=1 z=0"
  }
}
