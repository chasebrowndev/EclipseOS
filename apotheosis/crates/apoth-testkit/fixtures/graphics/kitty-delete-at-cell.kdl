fixture "kitty-delete-at-cell" {
  desc "d=p removes placements over a 1-based cell"
  covers "T03-GRAPHICS-KITTY"
  size rows=3 cols=6
  feed #"\e_Ga=T,f=24,s=2,v=1,i=7,C=1,q=1;/wAA/wAA\e\\"#
  feed #"\e[2;3H"#
  feed #"\e_Ga=T,f=24,s=2,v=1,i=8,C=1,q=1;/wAA/wAA\e\\"#
  feed #"\e_Ga=d,d=p,x=3,y=2\e\\"#
  images {
    row "kitty row=0 col=0 cols=1 rows=1 z=0"
  }
}
