  feed #"\e_Ga=T,f=24,s=2,v=1,i=9,C=1,q=1;/wAA/wAA\e\\"#
  feed #"\e_Ga=T,f=24,s=2,v=1,i=12,C=1,q=1;/wAA/wAA\e\\"#
  feed #"\e_Ga=d,d=r,x=7,y=9\e\\"#
