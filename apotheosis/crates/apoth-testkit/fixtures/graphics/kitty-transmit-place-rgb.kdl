fixture "kitty-transmit-place-rgb" {
  desc "a=T direct RGB places at the cursor; cursor moves right by cols, down by rows"
  covers "T03-GRAPHICS-KITTY"
  size rows=4 cols=6
  feed #"ab\e_Ga=T,f=24,s=2,v=1,i=7;/wAA/wAA\e\\"#
  replies #"\e_Gi=7;OK\e\\"#
  images {
    row "kitty row=0 col=2 cols=1 rows=1 z=0"
  }
  cursor row=1 col=3
}
