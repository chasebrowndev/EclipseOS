review {
  fixture "alt-decrqm-while-active" "DECRQM 47 while 1049 is active: assumed all four alt-screen modes report the one alt-screen state"
  fixture "c1-osc-not-ended-by-raw-9c" "title text of a raw 0x9C inside an OSC payload: lossy U+FFFD assumed; T-03 section 3.1 does not say how invalid UTF-8 in a title is decoded"
  fixture "charset-dec-special-all" "DEC Special Graphics: U+2424 for 'h' (NL symbol) and U+23BA..23BD for o/p/r/s follow the xterm/VT100 Unicode mapping; T-03 does not list the table"
  fixture "edit-dch-bce" "BCE on the cells exposed by DCH; not stated in T-03"
  fixture "erase-ech-bce" "BCE, see erase-ed0-bce"
  fixture "erase-ed0-bce" "background-colour erase (BCE) is implied by the BgOnly cell (T-02 1.2) but T-03 never states it"
  fixture "erase-el-bce" "BCE, see erase-ed0-bce"
  fixture "lrm-lf-scrolls-within-margins" "LF at the bottom with left/right margins set scrolls only the margin columns; history stays empty because the scroll is not full width"
  fixture "osc-color-10-11-12-set-and-query" "reply format, see reports-osc4-query-bel"
  fixture "osc-color-name-spec" "the name table (red = ff0000) is the X11 one; T-03 says 'by name or rgb spec' only"
  fixture "osc-color-short-rgb-form" "XParseColor scaling (f -> ffff, 8 -> 8888)"
  fixture "osc-color-two-queries-in-one-osc4" "one reply per queried index is assumed; T-03 does not say"
  fixture "osc-title-0" "OSC 0 is assumed to emit one title event; T-03 does not say whether the icon name is tracked or evented separately"
  fixture "osc-title-1-icon" "OSC 1 icon-name event is assumed to exist; T-03 only lists OSC 0/1/2 titles"
  fixture "osc-title-over-cap-dropped" "an over-cap OSC is dropped whole (T-01 section 3.1 OverCap); T-03 does not say whether a truncated title could be applied instead"
  fixture "osc-title-ris-clears-stack" "RIS may also emit a title-reset event; T-03 does not say"
  fixture "osc-title-stack-lifo" "see osc-title-stack-push-pop"
  fixture "osc-title-stack-push-pop" "popping the title stack is assumed to emit a title event; T-03 does not say"
  fixture "osc-title-strips-c0" "how a stray C0 byte inside an OSC payload reaches the sanitiser depends on the parser; the stripped result is what T-03 requires"
  fixture "osc133-d-without-status" "see osc133-prompt-marks"
  fixture "osc133-prompt-marks" "event text form `mark:<kind>[;status]` is this harness's vocabulary; the real event type is T-11 section 3"
  fixture "osc133-st-terminator" "see osc133-prompt-marks"
  fixture "osc52-invalid-base64-dropped" "invalid base64 is assumed to drop the write silently; the spec gap is noted in the M9 report"
  fixture "osc52-write-clipboard" "event text form is this harness's vocabulary; the real clipboard-set event is T-18/T-11"
  fixture "osc52-write-empty-selection" "an empty selection field is assumed to mean the clipboard (c); T-18 section 3 does not say"
  fixture "osc52-write-primary" "see osc52-write-clipboard"
  fixture "osc52-write-st" "see osc52-write-clipboard"
  fixture "osc7-percent-encoding-passed-through" "the event carries the URI as received; decoding belongs to the consumer (T-14), T-03 does not say"
  fixture "osc8-id-251-rejected" "a 251-byte id: assumed to reject the whole link; T-03 does not say"
  fixture "osc8-uri-too-long-rejected" "T-02/T-18 give the limit but not the failure behaviour; assuming the link is ignored and printing continues"
  fixture "osc9-4-missing-value" "a missing value is assumed to be 0; T-03 says only 'value 0-100 clamped'"
  fixture "osc9-non-selector-digits-are-text" "'4x' and '13;hi' are taken as notification text because their first field is not a decimal number in 1..12"
  fixture "reports-decrqm-mouse-defaults" "mode 1001 (highlight tracking) is Never in T-03 section 3.3; its DECRQM value (4, permanently reset) is assumed"
  fixture "reports-decrqm-never-modes" "DECRQM answer for a Never mode (4, permanently reset) is assumed; T-03 only says consumed and ignored"
  fixture "reports-decrqss-sgr-attrs" "the underline entry is `4:n`; for a plain single underline that reads `4:1` (T-03 table says `4:n`)"
  fixture "reports-decrqss-sgr-palette-forms" "background bright palette (100..107) form is implied by the foreground rule; T-03 lists only 30-37/90-97 explicitly"
  fixture "reports-dsr-5" "DSR 5 reply `CSI 0 n` (device OK) is the xterm form; T-03 does not spell it"
  fixture "reports-dsr-decxcpr" "DECXCPR page number (1) is the xterm form; T-03 names DECXCPR without its bytes"
  fixture "reports-osc10-query-bel" "see reports-osc4-query-bel"
  fixture "reports-osc11-query-st" "see reports-osc4-query-bel"
  fixture "reports-osc4-query-bel" "the reply colour format rgb:rrrr/gggg/bbbb (16-bit, 8-bit value doubled) is the xterm form; T-03 does not spell it"
  fixture "reports-osc4-query-st" "see reports-osc4-query-bel"
  fixture "resize-resets-scroll-region" "xterm resets margins on resize; T-03 does not say"
  fixture "resize-shrink-rows-content-to-history" "T-02 section 3 never says that shrinking rows pushes the top rows into scrollback (primary screen); xterm-style assumed"
  fixture "resize-tab-stops-extend" "default tab stops beyond the old width after a grow are xterm behaviour; T-03 does not say"
  fixture "resize-wide-glyph-cut-by-truncation" "interactive resize truncates (T-02 section 3); once reflow lands (M12) a wide glyph on a non-wrapped row may wrap instead"
  fixture "ris-clears-history" "whether RIS also clears the saved lines is not stated in T-03 section 3.1 (xterm does)"
  fixture "scroll-bce-new-row" "BCE on the row exposed by a scroll; not stated in T-03"
  fixture "scroll-region-top-anchored-feeds-history" "a full-width region anchored at row 1 but ending above the last row: T-03 says 'full-width, top-anchored scrolls feed history'; reading that as including this case"
  fixture "scroll-su" "SU feeding history is read from 'full-width, top-anchored scrolls feed history'; T-03 names no SU row"
  fixture "scroll-su-default-and-count" "see scroll-su"
  fixture "sgr-mixed-separators-following-param" "after a consumed mixed-separator colour spec, the next parameter (;4) is assumed to apply normally; T-03 says 'consumed' without bounding it"
  fixture "sgr-param-saturates-then-ignored" "a parameter beyond u32 saturates (T-01 section 2.3) and is then an unknown SGR code"
  fixture "sgr-rapid-blink-as-blink" "SGR 6 (rapid blink) folded into blink: the cell format has one blink bit; T-03 does not say"
  fixture "sgr-unknown-underline-style" "4:9 (unknown style): assumed consumed with no change; T-03 says only 'unknown sub-parameter forms are consumed'"
  fixture "wide-awm-off-at-last-column" "a wide glyph at the last column with autowrap off: T-02/T-04 do not say; assuming it is not printed"
  fixture "wide-cluster-then-cursor-move-new-cell" "a cluster never extends across a cursor movement (T-04 section 2): the second regional indicator starts its own wide cell; exact placement assumed"
  fixture "wide-hangul-jamo-cluster" "conjoining jamo cluster width (2) assumed from the grapheme-cluster rule"
  fixture "wide-keycap" "keycap sequence width (2) follows the common emoji-presentation reading; T-04 gives no keycap row"
  fixture "wrap-erase-line-then-print" "printing after EL with pending wrap: whether erase clears the pending-wrap flag is not stated; if it does not, F wraps to row 2"
}
