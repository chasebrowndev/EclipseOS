fixture "tab-ris-restores-defaults" rows=1 cols=20 { feed "\e[3g\ec\tx"; grid "        x" }
fixture "tab-tbc-unknown-ignored" rows=1 cols=20 { feed "\e[7g\tx"; grid "        x" }
