// Character sets, tabs and width (T-03 §3.1, UNICODE-11, VTCORE-14, T-04 §2-3).
fixture "cs-dec-line-drawing" rows=1 cols=8 { feed "\e(0lqk"; grid "┌─┐" }
fixture "cs-dec-box" rows=3 cols=4 { feed "\e(0lqk\r\nx x\r\nmqj"; grid "┌─┐" "│ │" "└─┘" }
