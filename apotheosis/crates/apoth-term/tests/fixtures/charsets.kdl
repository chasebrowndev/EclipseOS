fixture "cs-ss2-g2" rows=1 cols=4 { feed "\e*0\eNqq"; grid "─q" }
fixture "tab-default-every-8" rows=1 cols=20 { feed "\tx\tx"; grid "        x       x" }
fixture "tab-hts-adds-stop" rows=1 cols=20 { feed "\e[1;4H\eH\r\tx"; grid "   x" }
